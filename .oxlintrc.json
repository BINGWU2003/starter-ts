{
  "$schema": "https://unpkg.com/oxlint@1.79.0/configuration_schema.json",
  "categories": {
    "correctness": "deny",
    "perf": "deny",
    "suspicious": "deny"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/.turbo/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny",
    "typeAware": true
  },
  "plugins": ["oxc", "typescript", "unicorn", "vitest"]
}
